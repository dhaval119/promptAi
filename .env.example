# Copy this file to .env.local and fill in your real keys.
# .env.local is already git-ignored so your keys never get pushed to GitHub.

# Primary model - Gemini (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key_here

# Optional fallback - Groq (used automatically if Gemini fails)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama3-70b-8192
PRIMARY_API=gemini

# ---------------------------------------------------------------------------
# Firebase (Auth + Firestore) - same project your PHP login.php/signup.php
# already used (prompt1-580fc). These MUST be prefixed with NEXT_PUBLIC_
# because Firebase's web SDK runs in the browser - this is normal, a
# Firebase web apiKey is not a secret (your PHP files already exposed the
# same values inline). Prefilled below so this works out of the box; swap
# them for a different Firebase project's config if you ever need to.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBEJCtZRp5VkMASpbOgzPDY_YsT7ok3BJ0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=prompt1-580fc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=prompt1-580fc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=prompt1-580fc.firebasestorage.app
