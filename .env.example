# Copy this file to .env.local and fill in your real keys.
# .env.local is already git-ignored so your keys never get pushed to GitHub.

# Primary model - Gemini (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key_here

# Optional fallback - Groq (used automatically if Gemini fails/quota runs out)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama3-70b-8192

# Which one to try first: "gemini" or "groq"
PRIMARY_API=gemini
